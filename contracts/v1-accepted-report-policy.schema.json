{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trained-assist.github.io/trained-assist-recruiting-web/contracts/v1-accepted-report-policy.schema.json",
  "title": "Private profile-, candidate- and vacancy-bound report policy",
  "type": "object",
  "required": ["domainApiVersion", "candidateId", "vacancyId", "policyRevision", "forbiddenPhrases", "updatedAt"],
  "properties": {
    "domainApiVersion": { "const": "v1" },
    "candidateId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "vacancyId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "policyRevision": { "type": "string", "pattern": "^policy-r[0-9]+$" },
    "forbiddenPhrases": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "updatedAt": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^ ]+Z$" }
  },
  "additionalProperties": false
}
