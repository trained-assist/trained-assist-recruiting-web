  "capabilities": [
    {
      "toolId": "recruiting.cold_search.manage_schedule",
      "name": "manage_cold_search_schedule",
      "description": "Enable, disable, or read a synthetic cold-search schedule for the caller's trusted profile.",
      "mutates": true,
      "operationRef": "createColdSearchScheduleHandler.handle",
      "inputSchemaRef": "v1-cold-search-schedule-command.schema.json",
      "outputSchemaRef": "v1-cold-search-schedule-result.schema.json",
      "effect": "schedule_state",
      "requiredScopes": ["recruiting.candidateSearch"]
    },
    {
      "toolId": "recruiting.cold_search.list_occurrences",
      "name": "list_cold_search_occurrences",
      "description": "Read synthetic search occurrence statuses and completed result snapshots for the caller's trusted profile.",
      "mutates": false,
      "operationRef": "createColdSearchScheduleHandler.listOccurrences",
      "inputSchemaRef": "v1-cold-search-occurrences-query.schema.json",
      "outputSchemaRef": "v1-cold-search-occurrences.schema.json",
      "effect": "read",
      "requiredScopes": ["recruiting.candidateSearch"]
    }
  ]
