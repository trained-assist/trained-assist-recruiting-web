{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "urn": "urn:trained-assist:recruiting-capabilities:v1",
  "version": 1,
  "domainApiVersion": "v1",
  "platformContractRange": ">=1.0.0 <2.0.0",
  "relayContract": {
    "urn": "urn:trained-assist:capability-relay-contract:v1",
    "versionRange": ">=1 <2",
    "source": {
      "repository": "trained-assist/trained-assist-agent",
      "revision": "ffdc3dde6f1390d1965825a046533f3a4524c78b",
      "path": "contracts/capability-relay-v1.contract.json",
