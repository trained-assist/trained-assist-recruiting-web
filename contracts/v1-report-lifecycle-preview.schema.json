{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trained-assist.github.io/trained-assist-recruiting-web/contracts/v1-report-lifecycle-preview.schema.json",
  "title": "Private preview of a synthetic report draft",
  "type": "object",
  "required": ["domainApiVersion", "mode", "audience", "previewOnly", "publication", "reportRef", "candidateId", "vacancyId", "sourceRevision", "reportRevision", "status", "reviewState", "clientView", "html"],
  "properties": {
    "domainApiVersion": { "const": "v1" },
    "mode": { "const": "preview" },
    "audience": { "const": "client" },
    "previewOnly": { "const": true },
    "publication": { "const": "not_shared" },
    "reportRef": { "type": "string", "pattern": "^report_demo_[a-f0-9]{12}$" },
    "candidateId": { "type": "string", "pattern": "^candidate_demo_[0-9]{3}$" },
    "vacancyId": { "type": "string", "pattern": "^vac_demo_[0-9]{3}$" },
    "sourceRevision": { "type": "string", "pattern": "^synthetic-[a-z0-9-]+-r[0-9]+$" },
    "reportRevision": { "type": "string", "pattern": "^report-demo-r[0-9]+$" },
    "status": { "type": "string", "enum": ["draft", "published"] },
    "reviewState": { "type": "string", "enum": ["unreviewed", "approved", "changes_requested"] },
    "clientView": { "$ref": "v1-client-report-preview.schema.json#/properties/clientView" },
    "html": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
