{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trained-assist.github.io/trained-assist-recruiting-web/contracts/v1-manual-search-run.schema.json",
  "title": "Synthetic manual cold-search run status",
  "type": "object",
  "required": ["domainApiVersion", "runId", "vacancyId", "status", "search", "atsRefresh", "automaticRetryAllowed", "startedAt", "updatedAt"],
  "properties": {
    "domainApiVersion": { "const": "v1" },
    "runId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "vacancyId": { "type": "string", "pattern": "^vac_demo_[0-9]{3}$" },
    "resultJobId": { "type": "string", "pattern": "^search_demo_[a-f0-9]{12}$" },
    "status": { "enum": ["queued", "running", "completed", "partial", "failed", "outcome_unknown"] },
    "search": {
      "type": "object",
      "required": ["status", "phase", "pagesCompleted", "totalPages", "resultCount", "sourceRevision"],
      "properties": {
        "status": { "enum": ["queued", "running", "partial", "completed", "failed", "outcome_unknown"] },
        "phase": { "enum": ["queued", "search", "partial", "completed", "failed", "outcome_unknown", "dispatch", "page_limit"] },
        "pagesCompleted": { "type": "integer", "minimum": 0 },
        "totalPages": { "type": ["integer", "null"], "minimum": 1 },
        "resultCount": { "type": "integer", "minimum": 0 },
        "sourceRevision": { "type": ["string", "null"], "pattern": "^cold-search-provider-demo-r[0-9]+$" },
        "error": {
          "type": ["object", "null"],
          "required": ["code"],
          "properties": { "code": { "enum": ["provider_forbidden", "provider_unavailable", "provider_invalid_response", "search_outcome_unknown", "idempotency_conflict", "search_job_capacity_reached", "search_page_limit_reached"] } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "atsRefresh": {
      "type": "object",
      "required": ["status", "completed", "total"],
      "properties": {
        "status": { "enum": ["not_started", "pending", "complete", "blocked", "outcome_unknown"] },
        "completed": { "type": "integer", "minimum": 0 },
        "total": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "automaticRetryAllowed": { "const": false },
    "startedAt": { "type": "string", "pattern": "^202[0-9]-[0-9]{2}-[0-9]{2}T.*Z$" },
    "updatedAt": { "type": "string", "pattern": "^202[0-9]-[0-9]{2}-[0-9]{2}T.*Z$" },
    "finishedAt": { "type": "string", "pattern": "^202[0-9]-[0-9]{2}-[0-9]{2}T.*Z$" }
  },
  "additionalProperties": false
}
