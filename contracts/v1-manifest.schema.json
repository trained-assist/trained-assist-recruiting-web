{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trained-assist.github.io/trained-assist-recruiting-web/contracts/v1-manifest.schema.json",
  "title": "Recruiting service manifest",
  "type": "object",
  "required": ["serviceId", "release", "platformContractRange", "domainApiVersion", "capabilities", "readiness", "compatibility", "endpoints"],
  "properties": {
    "serviceId": { "const": "trained-assist.recruiting" },
    "release": {
      "type": "object",
      "required": ["version", "sourceRevision", "environment"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "enum": ["local"] }
      },
      "additionalProperties": false
    },
    "platformContractRange": { "type": "string", "pattern": "^>=\\d+\\.\\d+\\.\\d+ <\\d+\\.\\d+\\.\\d+$" },
    "domainApiVersion": { "const": "v1" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "required", "inputSchemaRef", "outputSchemaRef", "effect", "requiredScopes", "operationRef"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "required": { "type": "boolean" },
          "inputSchemaRef": { "type": "string", "minLength": 1 },
          "outputSchemaRef": { "type": "string", "minLength": 1 },
          "effect": { "type": "string", "enum": ["read", "write", "external_side_effect"] },
          "requiredScopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "operationRef": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "readiness": {
      "type": "object",
      "required": ["status", "reason", "checkedVersionTuple"],
      "properties": {
        "status": { "type": "string", "enum": ["ready", "degraded", "blocked", "unavailable"] },
        "reason": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "checkedVersionTuple": {
          "type": "object",
          "required": ["releaseVersion", "sourceRevision", "environment", "platformContractRange", "domainApiVersion"],
          "properties": {
            "releaseVersion": { "type": "string", "minLength": 1 },
            "sourceRevision": { "type": "string", "minLength": 1 },
            "environment": { "const": "local" },
            "platformContractRange": { "type": "string", "minLength": 1 },
            "domainApiVersion": { "const": "v1" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": ["deprecatedCapabilities"],
      "properties": {
        "deprecatedCapabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "version", "replacement"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "replacement": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "endpoints": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": false
}
