{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trained-assist/trained-assist-recruiting-web/contracts/v1-real-hh-result.schema.json",
  "title": "Completed real HH cold-search result v1",
  "type": "object",
  "required": ["version", "profileId", "vacancyId", "jobId", "searchedAt", "criteriaRevision", "sourceRevision", "source", "totalCollected", "candidates"],
  "properties": {
    "version": { "const": "hh-result-v1" },
    "profileId": { "$ref": "#/$defs/id" },
    "vacancyId": { "$ref": "#/$defs/id" },
    "jobId": { "$ref": "#/$defs/id" },
    "searchedAt": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "criteriaRevision": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "source": { "enum": ["manual", "scheduled"] },
    "totalCollected": { "type": "integer", "minimum": 0 },
    "candidates": { "type": "array", "maxItems": 20000, "items": { "$ref": "#/$defs/candidate" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "candidate": {
      "type": "object",
      "required": ["id", "vacancyId", "hhUrl", "title", "firstName", "lastName", "age", "area", "totalExperienceMonths", "totalExperienceYears", "salary", "recentCompanies", "experience", "preScore", "preScoreSignals", "preTag", "totalPossible", "atsScore", "atsTag", "knockout"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "vacancyId": { "$ref": "#/$defs/id" },
        "hhUrl": { "type": "string", "pattern": "^https://(www\\.)?hh\\.ru/resume/[A-Za-z0-9]+" },
        "title": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "age": { "type": ["integer", "null"], "minimum": 0 },
        "area": { "type": "string" },
        "totalExperienceMonths": { "type": "integer", "minimum": 0 },
        "totalExperienceYears": { "type": "number", "minimum": 0 },
        "salary": { "type": ["object", "null"], "properties": { "amount": { "type": "number", "minimum": 0 }, "from": { "type": "number", "minimum": 0 }, "to": { "type": "number", "minimum": 0 }, "currency": { "type": "string" }, "gross": { "type": ["boolean", "null"] } }, "additionalProperties": false },
        "recentCompanies": { "type": "array", "items": { "type": "string" } },
        "experience": { "type": "array", "maxItems": 5, "items": { "type": "object", "required": ["position", "company", "start", "end"], "properties": { "position": { "type": "string" }, "company": { "type": "string" }, "start": { "type": "string" }, "end": { "type": ["string", "null"] } }, "additionalProperties": false } },
        "preScore": { "type": "number", "minimum": 0 },
        "preScoreSignals": { "type": "array", "items": { "type": "string" } },
        "preTag": { "enum": ["PASS", "REVIEW", "WEAK"] },
        "totalPossible": { "type": "number", "minimum": 0 },
        "atsScore": { "type": "null" },
        "atsTag": { "type": "null" },
        "knockout": { "type": "object", "required": ["status", "criteria"], "properties": { "status": { "const": "pending_ai" }, "criteria": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false }
      },
      "additionalProperties": false
    }
  }
}
