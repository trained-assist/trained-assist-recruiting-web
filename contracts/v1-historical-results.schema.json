{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trained-assist/trained-assist-recruiting-web/contracts/v1-historical-results.schema.json",
  "type": "object",
  "required": ["ok", "vacancyId", "status", "searchedAt", "total", "historicalRevision", "candidates"],
  "properties": {
    "ok": { "const": true },
    "vacancyId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "status": { "const": "historical_only" },
    "searchedAt": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T" },
    "total": { "type": "integer", "minimum": 0 },
    "historicalRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "candidates": { "type": "array", "maxItems": 20000,
      "items": { "type": "object", "required": ["id", "title", "firstName", "lastName", "area", "score", "hhUrl"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
          "title": { "type": "string", "maxLength": 500 },
          "firstName": { "type": "string", "maxLength": 500 },
          "lastName": { "type": "string", "maxLength": 500 },
          "area": { "type": "string", "maxLength": 500 },
          "score": { "type": ["number", "null"] },
          "hhUrl": { "type": "string", "maxLength": 500 }
        }, "additionalProperties": false }
    }
  },
  "additionalProperties": false
}
