{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trained-assist.github.io/trained-assist-recruiting-web/contracts/v1-candidate-state.schema.json",
  "title": "R-03 profile-owned candidate state v1",
  "type": "object",
  "required": ["stateVersion", "profileId", "candidates", "seenByVacancy", "snapshotsByVacancy", "commentsByVacancy", "queriesByVacancy"],
  "properties": {
    "stateVersion": { "const": "v1" },
    "profileId": { "type": "string", "minLength": 1 },
    "candidates": { "type": "object", "additionalProperties": { "$ref": "#/$defs/candidate" } },
    "seenByVacancy": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^202[0-9]-[0-9]{2}-[0-9]{2}(T.*)?$" } } },
    "snapshotsByVacancy": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/snapshot" } } },
    "commentsByVacancy": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/comment" } } },
    "queriesByVacancy": { "type": "object", "additionalProperties": { "$ref": "#/$defs/query" } }
  },
  "additionalProperties": false,
  "$defs": {
    "review": {
      "type": "object", "required": ["status", "score"],
      "properties": { "status": { "enum": ["active", "starred", "archived"] }, "score": { "type": ["number", "null"], "minimum": 0, "maximum": 10 } },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object", "required": ["candidateRef", "title", "source", "foundAt", "wildcard", "vacancyIds", "reviewsByVacancy"],
      "properties": {
        "candidateRef": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
        "source": { "enum": ["search", "manual"] }, "foundAt": { "type": "string" },
        "wildcard": { "type": "boolean" }, "vacancyIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "reviewsByVacancy": { "type": "object", "additionalProperties": { "$ref": "#/$defs/review" } }
      }, "additionalProperties": false
    },
    "snapshot": {
      "type": "object", "required": ["stateVersion", "profileId", "vacancyId", "jobId", "searchedAt", "candidateRefs", "totalCollected", "totalAfterFilter"],
      "properties": {
        "stateVersion": { "const": "v1" }, "profileId": { "type": "string" }, "vacancyId": { "type": "string" },
        "jobId": { "type": "string" }, "searchedAt": { "type": "string" }, "criteriaRevision": { "type": "string" }, "sourceRevision": { "type": "string" },
        "candidateRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "totalCollected": { "type": "integer", "minimum": 0 }, "totalAfterFilter": { "type": "integer", "minimum": 0 },
        "newCount": { "type": "integer", "minimum": 0 }, "newCandidateRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }, "additionalProperties": false
    },
    "comment": { "type": "object", "required": ["text", "excludeFromSearch", "updatedAt"], "properties": { "text": { "type": "string" }, "excludeFromSearch": { "type": "boolean" }, "updatedAt": { "type": "string" } }, "additionalProperties": false },
    "query": { "type": "object", "required": ["criteriaRevision", "revision", "queries", "manual", "generatedAt"], "properties": { "criteriaRevision": { "type": "string" }, "revision": { "type": "string" }, "queries": { "type": "array", "items": { "type": "string" } }, "manual": { "type": "boolean" }, "generatedAt": { "type": "string" } }, "additionalProperties": false }
  }
}
