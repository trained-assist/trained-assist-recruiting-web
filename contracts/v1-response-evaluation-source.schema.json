{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trained-assist.github.io/trained-assist-recruiting-web/contracts/v1-response-evaluation-source.schema.json",
  "title": "Synthetic profile-bound response evaluation source",
  "type": "object",
  "required": ["responseId", "profileId", "vacancyId", "responseRevision", "resumeRevision", "criteriaRevision", "resume", "criteria"],
  "properties": {
    "responseId": { "type": "string", "pattern": "^response_demo_[0-9]{3}$" },
    "profileId": { "type": "string", "pattern": "^profile_demo_[0-9]{3}$" },
    "vacancyId": { "type": "string", "pattern": "^vac_demo_[0-9]{3}$" },
    "responseRevision": { "type": "string", "pattern": "^response-demo-[0-9]{3}-r[0-9]+$" },
    "resumeRevision": { "type": "string", "pattern": "^resume-demo-[0-9]{3}-r[0-9]+$" },
    "criteriaRevision": { "type": "string", "pattern": "^criteria-vac-demo-[0-9]{3}-r[0-9]+$" },
    "resume": { "type": "object", "required": ["facts"], "properties": { "facts": { "type": "array", "items": { "type": "object", "required": ["criterionId", "excerpt"], "properties": { "criterionId": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "excerpt": { "type": "string", "minLength": 1 } }, "additionalProperties": false } } }, "additionalProperties": false },
    "criteria": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "label", "required"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "label": { "type": "string", "minLength": 1 }, "required": { "type": "boolean" } }, "additionalProperties": false } }
  },
  "additionalProperties": false
}
