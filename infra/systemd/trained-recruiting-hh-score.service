[Unit]
Description=Trained Assist HH private accepted-candidate ATS scoring tick
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=trained-recruiting
Group=trained-recruiting
WorkingDirectory=/opt/trained-assist-recruiting-web/current
Environment=NODE_ENV=production
UMask=0077
StateDirectory=trained-assist/recruiting-web
StateDirectoryMode=0700
LoadCredential=hh_encryption_key:/etc/trained-assist/recruiting-web/secrets/hh_encryption_key
LoadCredential=hh_client_id:/etc/trained-assist/recruiting-web/secrets/hh_client_id
LoadCredential=hh_client_secret:/etc/trained-assist/recruiting-web/secrets/hh_client_secret
LoadCredential=ladder_token:/etc/trained-assist/recruiting-web/secrets/ladder_token
ExecStart=/usr/bin/node /opt/trained-assist-recruiting-web/current/src/r03-private-host-cli.js --mode score --config /etc/trained-assist/recruiting-web/config.json --secrets ${CREDENTIALS_DIRECTORY} --live-execution
TimeoutStartSec=55min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/trained-assist/recruiting-web
